
# Optional: lets Brahman search new questions with AI and add the answers to its knowledge.
# Users never need a key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Where learned knowledge is stored (must be on persistent disk). Default: ./data/learned-knowledge.json
# KNOWLEDGE_FILE=

# Token for removing learned entries on the /knowledge page.
# BRAHMAN_ADMIN_TOKEN=

# Maximum AI searches per day across all users (cost guard). Default: 200
# LEARN_DAILY_LIMIT=

# Optional: a natural human-like Indian male voice for Brahman (otherwise the device's built-in voice is used).
# Azure Speech (free tier: 0.5M characters/month) — voices hi-IN-MadhurNeural and en-IN-PrabhatNeural:
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=centralindia
# …or Google Cloud Text-to-Speech — voices hi-IN-Neural2-B and en-IN-Neural2-B:
# GOOGLE_TTS_API_KEY=
# Maximum characters synthesised per day across all users (cost guard). Default: 300000
# TTS_DAILY_CHAR_LIMIT=

# Paid reports (Razorpay — https://dashboard.razorpay.com → Settings → API Keys). Without keys, paid reports are hidden
# behind "coming soon"; the free basic kundli PDF always works.
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=
# A long random string that signs report unlock tokens (defaults to the Razorpay secret).
# REPORT_TOKEN_SECRET=
# Owner testing only: set to 1 (with REPORT_TOKEN_SECRET) to try the purchase flow without charging. Never on a live site.
# REPORTS_TEST_MODE=
